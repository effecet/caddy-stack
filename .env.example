# Copy to .env and fill in. .env is gitignored.
# Only needed if you use the OPTIONAL Portainer deploy path (`make deploy-portainer`).
# The default `make deploy` (plain docker compose) needs nothing here.

# Portainer per-stack webhook URL (Stacks > caddy > Webhook in the Portainer UI)
PORTAINER_WEBHOOK=https://10.0.0.10:9443/api/stacks/webhooks/REPLACE-WITH-UUID
